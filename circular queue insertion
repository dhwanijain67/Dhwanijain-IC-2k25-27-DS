#include <stdio.h>
#define MAX 5

int main()
{
    int q[MAX]={10,20,30};
    int f=0, r=2, x, i;

    printf("Enter element: ");
    scanf("%d", &x);

    if((r+1)%MAX==f)
        printf("Queue is Full");
    else
    {
        r=(r+1)%MAX;
        q[r]=x;

        printf("Circular Queue:\n");
        for(i=0; i<MAX; i++)
            printf("%d ", q[i]);
    }

    return 0;
}
