#include <iostream>
#include <stack>
using namespace std;

int main() {
    stack<int> s1;

    s1.push(10);
    s1.push(20);
    s1.push(30);

    stack<int> s2 = s1;

    cout << "Copied stack: ";

    while (!s2.empty()) {
        cout << s2.top() << " ";
        s2.pop();
    }

    return 0;
}
