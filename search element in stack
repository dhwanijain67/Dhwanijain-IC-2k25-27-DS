#include <iostream>
#include <stack>
using namespace std;

int main() {
    stack<int> s;

    s.push(10);
    s.push(20);
    s.push(30);
    s.push(40);

    int key = 20;
    bool found = false;

    while (!s.empty()) {
        if (s.top() == key) {
            found = true;
            break;
        }
        s.pop();
    }

    if (found)
        cout << "Element found";
    else
        cout << "Element not found";

    return 0;
}
