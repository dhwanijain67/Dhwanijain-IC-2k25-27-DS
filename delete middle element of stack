#include <iostream>
#include <stack>
using namespace std;

void deleteMiddle(stack<int>& s, int k) {
    if (k == 0) {
        s.pop();
        return;
    }

    int x = s.top();
    s.pop();

    deleteMiddle(s, k - 1);

    s.push(x);
}

int main() {
    stack<int> s;
    s.push(10);
    s.push(20);
    s.push(30);
    s.push(40);
    s.push(50);

    deleteMiddle(s, s.size() / 2);

    while (!s.empty()) {
        cout << s.top() << " ";
        s.pop();
    }
}
