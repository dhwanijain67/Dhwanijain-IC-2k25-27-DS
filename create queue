
#include <stdio.h>
#define MAX 100

int main() {
    int queue[MAX];
    int front = -1, rear = -1;
    int n, i;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX) {
        printf("Invalid size");
        return 0;
    }

    printf("Enter queue elements:\n");

    for (i = 0; i < n; i++) {
        scanf("%d", &queue[i]);
    }

    front = 0;
    rear = n - 1;

    printf("Queue elements: ");

    for (i = front; i <= rear; i++) {
        printf("%d ", queue[i]);
    }

    return 0;
}
