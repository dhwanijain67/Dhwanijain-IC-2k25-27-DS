
#include <stdio.h>
#define MAX 100

int main() {
    int queue[MAX] = {10, 20, 30, 40};
    int front = 0, rear = 3;

    if (front == -1 || front > rear) {
        printf("Queue Underflow");
    } else {
        printf("Deleted element: %d", queue[front]);
        front++;

        if (front > rear) {
            front = rear = -1;
        }
    }

    return 0;
}
