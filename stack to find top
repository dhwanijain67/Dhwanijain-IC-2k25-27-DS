#include <iostream>
using namespace std;
#define MAX 5

int stack[MAX];
int top = - 1;

void push(int x)
{
    if(top == MAX - 1)
    cout<<"stack overflow\n";
    else
    {
        top++;
        stack[top] = x;
    }
}

void pop()
{
    if(top == -1)
    cout<<"stack underflow\n";
    else
    top--;
}

int main()
{
   push(20);
   push(40);
   pop();
   push(60);
   push(80);
   pop();
   push(90);

cout<<"Top = "<<top;
    return 0;
}
