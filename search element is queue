#include <stdio.h>
int main()
{
    int q[5]={10,20,30,40,50};
    int x, i, found=0;

    printf("Enter element to search: ");
    scanf("%d", &x);

    for(i=0; i<5; i++)
    {
        if(q[i]==x)
        {
            found=1;
            break;
        }
    }

    if(found==1)
        printf("Element Found");
    else
        printf("Element Not Found");

    return 0;
}
