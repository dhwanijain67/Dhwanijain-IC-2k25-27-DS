#include <stdio.h>
#define MAX 5

int main()
{
    int q[MAX]={10,20,30};
    int f=0, r=2, i;

    if(f==-1)
        printf("Queue is Empty");
    else
    {
        printf("Deleted element: %d\n", q[f]);

        if(f==r)
            f=r=-1;
        else
            f=(f+1)%MAX;

        if(f!=-1)
        {
            printf("Queue after deletion:\n");
            i=f;
            while(1)
            {
                printf("%d ", q[i]);
                if(i==r) break;
                i=(i+1)%MAX;
            }
        }
    }

    return 0;
}
