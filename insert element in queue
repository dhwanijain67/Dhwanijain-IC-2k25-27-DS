
#include <stdio.h>
#define MAX 100

int main() {
    int queue[MAX];
    int front = -1, rear = -1;
    int value;

    if (rear == MAX - 1) {
        printf("Queue Overflow");
    } else {
        printf("Enter element: ");
        scanf("%d", &value);

        if (front == -1)
            front = 0;

        rear++;
        queue[rear] = value;

        printf("Element inserted successfully");
    }

    return 0;
}
